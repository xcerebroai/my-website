{
  "name": "my-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:ghl": "tsc -b && vite build --mode ghl --outDir dist-ghl",
    "build:jarvis": "tsc -b && vite build --mode jarvis --outDir dist-jarvis",
    "build:checkout": "tsc -b && vite build --mode checkout --outDir dist-checkout",
    "build:thankyou": "tsc -b && vite build --mode thankyou --outDir dist-thankyou",
    "build:matrix": "tsc -b && vite build --mode matrix --outDir dist-challenge",
    "placeholders": "node scripts/generate-placeholders.mjs"
  },
  "dependencies": {
    "motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
